{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "$HOME/.config/fastfetch/mk.txt",
    // "source": "$HOME/.config/fastfetch/Official_gnu.svg",
    // "width": 15,
    // "height": 18,
    "padding": {
      "top": 1,
      "left": 0,
      "right": 2
      // "bottom": 1
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "break",
    "colors"
  ]
}

